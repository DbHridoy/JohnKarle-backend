# Runtime
NODE_ENV=development
PORT=5200
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/john_karle

# CORS
# Use * for local development. Use comma-separated origins for deployed clients.
# Example: CORS_ORIGIN=https://johnkarle.com,https://admin.johnkarle.com
CORS_ORIGIN=*

# Authentication
# Generate a long random value before using production.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Optional seed user
# When SUPER_ADMIN_EMAIL and SUPER_ADMIN_PASSWORD are both set, the server
# creates this account at startup if it does not already exist.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Mail compatibility
# Currently parsed by the env loader. Keep false for standard STARTTLS SMTP.
SMTP_SECURE=false
OUTLOOK_EMAIL=your-email@outlook.com
OUTLOOK_PASSWORD=your-password-or-app-password
PASSWORD_RESET_CODE_EXPIRES_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=15


# Mail service using gmail smtp
GMAIL_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
GMAIL_APP_PASSWORD=

# AWS S3 storage
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Frontend app
APP_BASE_URL=http://localhost:3000
